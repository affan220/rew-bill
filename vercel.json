{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__originalPath=/api/:path*"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/index?__originalPath=/manus-storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
